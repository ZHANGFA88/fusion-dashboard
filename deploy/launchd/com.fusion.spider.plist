<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.fusion.spider</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__REPO__/modules/spider/server.mjs</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO__/modules/spider</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/fusion-spider.log</string>
  <key>StandardErrorPath</key><string>/tmp/fusion-spider.err</string>
</dict>
</plist>
