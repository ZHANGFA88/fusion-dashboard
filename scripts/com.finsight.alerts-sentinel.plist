<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.finsight.alerts-sentinel</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>__REPO_DIR__/scripts/push_alerts_sentinel.py</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>ALERT_STATE</key>
        <string>__REPO_DIR__/data/alert_push_state.json</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__REPO_DIR__/data/logs/sentinel.out.log</string>
    <key>StandardErrorPath</key>
    <string>__REPO_DIR__/data/logs/sentinel.err.log</string>
</dict>
</plist>
