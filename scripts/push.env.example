# FinSight 微信推送环境变量样例
# 用法：cp scripts/push.env.example scripts/push.env，然后填入真实值，
#       再在运行推送脚本前 source scripts/push.env
# 注意：push.env 含真实目标 ID，切勿提交到仓库
#       （本仓 .gitignore 尚未覆盖该文件名，建好后请自行确认不提交）。
#       本文件只放占位说明，不写任何真实目标 ID。

# openclaw 可执行文件路径
# macOS（Homebrew 默认）：/opt/homebrew/bin/openclaw
# Linux：填你实际安装 openclaw 的路径，可用 `which openclaw` 查询
OPENCLAW_BIN=/opt/homebrew/bin/openclaw

# 微信推送目标（好友/群的 wechat ID）
# 真实值形如：o9cq80zOXMiSDvE8M5PAioQH4PjM@im.wechat（示例格式，非真实）
# 不设置时脚本内置默认值；仅在需要覆盖时填写
WX_TARGET=

# FinSight 主干接口地址（默认本机 8770；融合后主干仍是 scripts/serve.py、端口不变）
API_BASE=http://127.0.0.1:8770

# ---- 以下为可选调优（都有内置默认值，一般不用改） ----
# ALERT_STATE        异动哨兵去重状态文件（默认 <仓库>/data/alert_push_state.json）
# STALE_STATE        陈旧哨兵告警冷却状态文件（默认 <仓库>/data/stale_alarm_state.json）
# ALERT_MIN_PCT      异动推送阈值，单窗涨跌幅绝对值%（默认 0.8）
# ALERT_MAX_PER_RUN  单次最多推送条数（默认 8）
# PICKS_TOP          早间选股推送名额（默认 6）
# STALE_SEC          交易时段内数据超多少秒算陈旧（默认 600）
# STALE_COOLDOWN     同一陈旧告警冷却秒数，防刷屏（默认 3600）
# STALE_SYMBOLS      指定监控标的（逗号分隔；留空=自动拉 watchlist）
